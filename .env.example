# Database (Postgres). Supabase, Neon, RDS or local.
DATABASE_URL="postgresql://finx:finx@localhost:5432/finx"

# Session signing secret — set a long random string in production
AUTH_SECRET="change-me-to-a-long-random-string"

# FinX AI chat + template translation (Anthropic API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Where uploaded documents are stored (local folder; swap for S3 in production)
STORAGE_DIR="./storage"

# Public URL of this deployment (used in links sent to borrowers)
APP_URL="http://localhost:3000"

# ---- Conversational AI channels (leave blank to run in simulation mode) ----
# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
# Email (SMTP — Gmail app password or any IMAP/SMTP provider)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
# SMS (any HTTP gateway, e.g. MSG91) — POSTs {to, text}
SMS_WEBHOOK_URL=""
SMS_API_KEY=""
# Voice AI (any outbound voice-agent provider) — POSTs a call request; results come back to /api/webhooks/voice
VOICE_PROVIDER_URL=""
VOICE_PROVIDER_KEY=""
